{
  "name": "litecraft",
  "version": "0.1.0",
  "description": "Browser-based Minecraft structure viewer, builder & farm simulator with .litematic import/export",
  "type": "module",
  "scripts": {
    "dev": "vite --port 7668",
    "build": "tsc && vite build",
    "preview": "vite preview --port 7668",
    "typecheck": "tsc",
    "gen:blocks": "node scripts/gen-blocks.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "private": true,
  "keywords": [
    "minecraft",
    "litematica",
    "voxel",
    "farm-simulator"
  ],
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
